# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://carbontrace:carbontrace@localhost:5432/carbontrace
SYNC_DATABASE_URL=postgresql://carbontrace:carbontrace@localhost:5432/carbontrace

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-secure-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=CarbonTrace
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# ── Email (mock — prints to console) ─────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@carbontrace.io
EMAIL_VERIFICATION_ENABLED=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
SUBMISSION_RATE_LIMIT=10/minute
